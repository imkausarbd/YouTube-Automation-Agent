    {
      "parameters": {
        "jsCode": "const inputJson = $input.first().json;\n\n// Debug: log the actual input structure so you can check it in the console\nconsole.log(JSON.stringify(inputJson));\n\n// Try common field paths — adjust based on what you see in console\nconst script =\n  inputJson.Script ||\n  inputJson.text ||\n  inputJson.output ||\n  '';\n\nif (!script) {\n  throw new Error('Script field is empty — check console log for actual input structure: ' + JSON.stringify(inputJson));\n}\n\nconst WORDS_PER_SECOND = 2.5; // rough estimate, tune later\nconst CHUNK_DURATION = 6;\nconst WORDS_PER_CHUNK = Math.round(WORDS_PER_SECOND * CHUNK_DURATION);\n\nconst words = script.replace(/\\n/g, ' ').trim().split(/\\s+/);\n\nconst chunks = [];\nlet chunkIndex = 0;\n\nfor (let i = 0; i < words.length; i += WORDS_PER_CHUNK) {\n  const chunkWords = words.slice(i, i + WORDS_PER_CHUNK);\n  chunks.push({\n    index: chunkIndex,\n    text: chunkWords.join(' '),\n    start: chunkIndex * CHUNK_DURATION,\n    end: (chunkIndex + 1) * CHUNK_DURATION\n  });\n  chunkIndex++;\n}\n\nreturn chunks.map(chunk => ({ json: chunk }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
